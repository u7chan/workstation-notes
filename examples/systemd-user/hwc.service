[Unit]
Description=hwc (Herdr web UI, LAN)
# 短時間の連続失敗で failed に落ち、再開されなくなるのを避ける。
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/workspace/hwc
# HWC は pi / gh / git / opencode を子プロセスで起動するので、対話シェルと同じ解決順を渡す。
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/share/mise/shims/bun --watch src/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
